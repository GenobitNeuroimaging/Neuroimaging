@article{sathishkumar2022alexnet,
  title = {{{AlexNet}} Approach for Early Stage {{Alzheimer}}’s Disease Detection from {{MRI}} Brain Images},
  author = {Sathish Kumar, L. and Hariharasitaraman, S. and Narayanasamy, Kanagaraj and Thinakaran, K. and Mahalakshmi, J. and Pandimurugan, V.},
